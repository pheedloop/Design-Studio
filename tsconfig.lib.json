{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["vite/client"],
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Shared modules referenced by the published surfaces must be listed, or their
  // .d.ts is never emitted while the importers still reference it.
  "include": [
    "src/editor/**/*",
    "src/viewer/**/*",
    "src/seatviewer/**/*",
    "src/types/**/*",
    "src/i18n/**/*",
    "src/utils/**/*",
    "src/tiers.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
