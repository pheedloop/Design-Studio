{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["vite/client"],
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Shared modules that the published surfaces reference must be listed here, or
  // vite-plugin-dts silently skips emitting their .d.ts while the surfaces that
  // import them still emit the import — a dangling reference that only hosts with
  // `skipLibCheck: false` ever see. `src/tiers.ts` was in exactly that state.
  "include": [
    "src/editor/**/*",
    "src/viewer/**/*",
    "src/seatviewer/**/*",
    "src/types/**/*",
    "src/i18n/**/*",
    "src/utils/**/*",
    "src/tiers.ts"
  ],
  // Tests are co-located with what they cover; they must not be type-checked
  // into the library build or emit declarations into dist/.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
