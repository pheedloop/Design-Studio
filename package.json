{
  "name": "@pheedloop/design-studio",
  "version": "0.3.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pheedloop/Design-Studio.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./editor": {
      "import": "./dist/editor.js",
      "types": "./dist/editor/index.d.ts"
    },
    "./viewer": {
      "import": "./dist/viewer.js",
      "types": "./dist/viewer/index.d.ts"
    },
    "./seatviewer": {
      "import": "./dist/seatviewer.js",
      "types": "./dist/seatviewer/index.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n.js",
      "types": "./dist/i18n/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "typesVersions": {
    "*": {
      "editor": [
        "./dist/editor/index.d.ts"
      ],
      "viewer": [
        "./dist/viewer/index.d.ts"
      ],
      "seatviewer": [
        "./dist/seatviewer/index.d.ts"
      ],
      "i18n": [
        "./dist/i18n/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:lib": "vite build --config vite.lib.config.ts --watch",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "pack:local": "npm run build:lib && npm pack --pack-destination . && mv -f pheedloop-design-studio-*.tgz design-studio.local.tgz",
    "prepublishOnly": "npm run build:lib",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "konva": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-konva": ">=18.0.0"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "react-icons": "^5.6.0",
    "react-json-tree": "^0.20.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'tsc -b --noEmit'",
      "bash -c './scripts/with-node.sh npx vitest run'"
    ]
  }
}
